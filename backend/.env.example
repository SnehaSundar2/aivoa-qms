# Copy to .env and fill in.

# --- Groq -------------------------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
# Reads uploaded images (photographed forms, and photos of the defect).
# Leave blank to disable the vision path and fall back to local OCR.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Database ---------------------------------------------------------------
# PostgreSQL (default):
DATABASE_URL=postgresql+psycopg://qms:qms@localhost:5432/qms_complaints
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://qms:qms@localhost:3306/qms_complaints

# If the database above is unreachable, fall back to a local SQLite file so the
# app still starts. Set to false to make a bad DATABASE_URL a hard failure.
ALLOW_SQLITE_FALLBACK=true

# --- Misc -------------------------------------------------------------------
MAX_UPLOAD_MB=15
